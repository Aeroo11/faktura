# Copy to .env.local. Local development values; see docs/auth.md.
FAKTURA_API_URL=http://127.0.0.1:8077
APP_URL=http://127.0.0.1:3077
OIDC_ISSUER=http://127.0.0.1:8180/realms/faktura
OIDC_CLIENT_ID=faktura-web
# Matches keycloak/faktura-realm.json (dev realm only; set a real secret anywhere else).
OIDC_CLIENT_SECRET=faktura-web-dev-secret
# Encrypts the session cookie. Generate: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FAKTURA_SESSION_SECRET=
# Show the demo accounts and passwords on the sign-in page.
FAKTURA_SHOW_DEMO_ACCOUNTS=1