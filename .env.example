# Copy to .env and fill in. .env is git-ignored: never commit keys.
# Personal Azure AI Foundry resource, v1 endpoint.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
FAKTURA_VISION_MODEL=gpt-6-luna
# low | medium | high; empty to omit the reasoning parameter
FAKTURA_REASONING_EFFORT=low

# Review-queue service. Matches docker-compose.yml (local development only).
DATABASE_URL=postgresql+psycopg://faktura:faktura-dev@127.0.0.1:5433/faktura
FAKTURA_DATA_DIR=data/synth/v2
